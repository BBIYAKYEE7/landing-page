# 의뢰 폼(/api/request) 설정 — 운영 값은 Vercel 프로젝트 환경변수에 넣는다.
# 로컬에서 쓸 때는 이 파일을 .env.local로 복사해 채운다(.env*는 git이 무시한다. 이 예시 파일만 추적).
# 설정 방법: integrations/google-apps-script/README.md

# Apps Script 웹 앱 URL (https://script.google.com/macros/s/.../exec)
REQUEST_ENDPOINT_URL=

# Apps Script 스크립트 속성 SECRET과 같은 값 (예: openssl rand -hex 32)
REQUEST_ENDPOINT_SECRET=

# 로컬 개발(npm run dev)에서만 1이면 저장 없이 흐름만 시험한다. 운영 빌드에서는 무시된다.
# REQUEST_DRY_RUN=1
